// prisma/schema.prisma

// ================================
// 1. KONFIGURASI DATABASE & GENERATOR
// ================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================
// 2. ENUM DEFINITIONS
// ================================
enum UserRole {
  READER
  AUTHOR
  ADMIN
}

enum NovelStatus {
  DRAFT
  PUBLISHED
  IN_REVIEW // Status baru untuk novel yang sedang direview
  ARCHIVED
  COMPLETED
}

enum PurchaseStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  CANCELLED
}

// ================================
// 3. DATA MODELS
// ================================

// Model User: Inti dari sistem, bisa sebagai pembaca atau penulis
model User {
  id       String   @id @default(cuid())
  email    String   @unique
  name     String?
  password String? // Untuk login email/password
  role     UserRole @default(READER)
  bio      String? // Bio penulis
  avatar   String? // URL foto profil

  // RELASI KE MODEL LAIN
  authoredNovels  Novel[]           @relation("NovelAuthor")
  chapters        Chapter[] // Seorang penulis bisa memiliki banyak chapter
  purchases       Purchase[]
  readingProgress ReadingProgress[]

  // NEXT-AUTH MODELS (WAJIB)
  accounts Account[]
  sessions Session[]

  // TIMESTAMPS
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// Model Novel: Representasi buku/cerita
model Novel {
  id            String      @id @default(cuid())
  title         String
  description   String?
  coverImage    String?
  genre         String[] // Genre: ["Fantasy", "Romance", "Mystery"]
  tags          String[] // Tags untuk pencarian
  status        NovelStatus @default(DRAFT)
  isPremium     Boolean     @default(false)
  price         Float? // Harga novel (jika premium)
  rating        Float?      @default(0) // Rating rata-rata
  totalChapters Int         @default(0)

  // RELASI
  author          User              @relation("NovelAuthor", fields: [authorId], references: [id])
  authorId        String
  chapters        Chapter[]
  purchases       Purchase[]
  readingProgress ReadingProgress[]

  // FITUR INTERAKTIF
  hasBranching    Boolean @default(false) // Apakah punya alur bercabang
  backgroundMusic String? // URL musik latar default

  // TIMESTAMPS
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("novels")
}

// Model Chapter: Representasi setiap bagian dari cerita
model Chapter {
  id            String  @id @default(cuid())
  title         String
  content       String  @db.Text
  chapterNumber Int
  isStart       Boolean @default(false) // Menandai chapter awal
  isEnd         Boolean @default(false) // Menandai chapter akhir
  isPremium     Boolean @default(false)
  price         Float?

  // RELASI
  novel    Novel  @relation(fields: [novelId], references: [id], onDelete: Cascade)
  novelId  String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  // Branching Narrative
  choicesAsSource       Choice[] @relation("ChoiceSource") // Pilihan yang berasal dari chapter ini
  choicesThatLeadToThis Choice[] @relation("ChoiceTarget") // Pilihan dari chapter lain yang mengarah ke sini

  // Multimedia
  backgroundMusic  String?
  customBackground String?
  soundEffects     String[]
  purchases        Purchase[]
  readingProgress  ReadingProgress[]

  // TIMESTAMPS
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("chapters")
}

model Choice {
  id            String  @id @default(cuid())
  text          String // Teks pilihan, e.g., "Ambil pedang"
  sourceChapter Chapter @relation("ChoiceSource", fields: [chapterId], references: [id], onDelete: Cascade)
  chapterId     String
  nextChapter   Chapter @relation("ChoiceTarget", fields: [nextChapterId], references: [id], onDelete: Cascade)
  nextChapterId String

  @@map("choices")
}

// Model Purchase: Transaksi pembelian
model Purchase {
  id              String         @id @default(cuid())
  status          PurchaseStatus @default(PENDING)
  amount          Float // Jumlah pembayaran
  snapToken       String? // Token dari Midtrans
  snapRedirectUrl String? // URL redirect Midtrans

  // RELASI
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  novel     Novel?   @relation(fields: [novelId], references: [id])
  novelId   String? // Bisa beli novel utuh atau item spesifik
  chapter   Chapter? @relation(fields: [chapterId], references: [id])
  chapterId String?

  // TIMESTAMPS
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("purchases")
}

// Model ReadingProgress: Menyimpan progres baca per user
model ReadingProgress {
  id        String   @id @default(cuid())
  userId    String
  novelId   String
  chapterId String // Menyimpan ID chapter terakhir yang dibaca
  progress  Float?   @default(0) // Progres dalam chapter (jika diperlukan)
  history   Json?    // Menyimpan riwayat pilihan dalam format JSON

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, novelId]) // Setiap user hanya punya satu progres per novel
}

// ================================
// 4. NEXT-AUTH MODELS (JANGAN DIUBAH)
// ================================
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}
